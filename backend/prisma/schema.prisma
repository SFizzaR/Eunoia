// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int @default(autoincrement()) @id 
  email           String @unique
  firstname       String 
  lastname        String
  password        String
  profileImageUrl String?
  coverImageUrl   String?
  entries         Entry[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("users")

}

model Entry {
  id          Int      @id @default(autoincrement())
  userId      Int
  content     String
  isDraft     Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotions    EntryEmotion[]
  reflection  EntryReflection?
  attachments Attachment[]

  @@index([userId])
  @@map("entries")

}

model Emotion {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  category          String?
  animatedEmojiUrl  String
  color             String
  createdAt         DateTime @default(now())
  entries           EntryEmotion[]
  @@map("emotions")
}

model EntryEmotion {
  id            Int      @id @default(autoincrement())
  entryId       Int
  emotionId     Int
  userSelected  Boolean  @default(false)
  aiDetected    Boolean  @default(false)
  confidence    Float?
  createdAt     DateTime @default(now())
  entry         Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  emotion       Emotion @relation(fields: [emotionId], references: [id], onDelete: Cascade)

  @@unique([entryId, emotionId])
  @@index([emotionId])
  @@map("entry_emotions")


}

model EntryReflection {
  id          Int      @id @default(autoincrement())
  entryId     Int      @unique
  reflection  String
  advice      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entry       Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@map("entry_reflections")

}

model Attachment {
  id        Int      @id @default(autoincrement())
  entryId   Int
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int?
  createdAt DateTime @default(now())
  entry     Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@unique([entryId, fileName]) // ← Prevents duplicates

  @@map("attachments")
}